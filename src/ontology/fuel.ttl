@prefix : <http://w3id.org/fuel/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix omv: <http://omv.ontoware.org/2005/05/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sdo: <https://schema.org/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix fuel: <http://w3id.org/fuel/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://w3id.org/fuel/> .

<http://w3id.org/fuel/> rdf:type owl:Ontology ;
                         owl:versionIRI <http://w3id.org/fuel/0.0.1> ;
                         dcterms:abstract "FUEL is a vocabulary designed to facilitate the interoperability of fusion energy data."@en ;
                         dcterms:created "2024-11-06"^^xsd:date ;
                         dcterms:creator [ rdf:type foaf:Person ,
                                                    sdo:Person ;
                                           rdfs:seeAlso <https://orcid.org/0000-0003-3499-8262> ;
                                           foaf:homepage <https://agbeltran.github.io/> ;
                                           foaf:name "Alejandra Gonzalez Beltran" ;
                                           sdo:affiliation [ sdo:identifier <https://ror.org/0361bwx64>
                                                           ] ;
                                           sdo:identifier <https://orcid.org/0000-0003-3499-8262> ;
                                           sdo:name "Alejandra Gonzalez Beltran"
                                         ] ;
                         dcterms:description "FUEL is a vocabulary designed to facilitate the interoperability of fusion energy data."@en ;
                         dcterms:issued "2024-11-06"^^xsd:date ;
                         dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                         dcterms:modified "2026-06-01"^^xsd:date ;
                         dcterms:title "FUsion Energy Lexicon"@en ;
                         vann:preferredNamespacePrefix "fuel" ;
                         vann:preferredNamespaceUri "https://w3id.org/fuel/" ;
                         rdfs:comment "FUsion Energy Lexicon (FUEL) is an OWL ontology for the interoperable description of fusion energy data, devices, plasmas, physical processes and other fusion energy concepts. FUEL provides a formal semantic framework for organizing fusion knowledge and it is intended to support consistent data annotation, integration, exchange, and reuse across fusion experiments, models, and computational workflows."@en ;
                         rdfs:label "FUsion Energy Lexicon"@en ,
                                    "Léxico de energía de fusión"@es ;
                         owl:versionInfo "0.0.1" ;
                         dcat:version "0.0.1" ;
                         sdo:codeRepository <https://github.com/ukaea/fuel> ;
                         mod:definitionProperty rdfs:comment ;
                         mod:hasRepresentationLanguage omv:OWL ;
                         mod:hasSyntax <http://www.w3.org/ns/formats/Turtle> ;
                         mod:prefLabelProperty rdfs:label ;
                         mod:status "active" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/hasPart
dcterms:hasPart rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://schema.org/image
<http://schema.org/image> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/dcat#version
dcat:version rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:AnnotationProperty .


###  https://schema.org/affiliation
sdo:affiliation rdf:type owl:AnnotationProperty .


###  https://schema.org/codeRepository
sdo:codeRepository rdf:type owl:AnnotationProperty .


###  https://schema.org/identifier
sdo:identifier rdf:type owl:AnnotationProperty .


###  https://schema.org/name
sdo:name rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#definitionProperty
mod:definitionProperty rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#hasRepresentationLanguage
mod:hasRepresentationLanguage rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#hasSyntax
mod:hasSyntax rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#prefLabelProperty
mod:prefLabelProperty rdf:type owl:AnnotationProperty .


###  https://w3id.org/mod#status
mod:status rdf:type owl:AnnotationProperty .


###  http://w3id.org/fuel/detectedBy
fuel:detectedBy rdf:type owl:AnnotationProperty ;
                rdfs:label "detected by"@en ,
                           "detectado por"@es ;
                rdfs:comment "A diagnostic sensor type typically used to detect or measure this plasma event or condition."@en .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2006/time#hasBeginning
time:hasBeginning rdf:type owl:ObjectProperty .


###  http://www.w3.org/2006/time#hasEnd
time:hasEnd rdf:type owl:ObjectProperty .


###  http://w3id.org/fuel/hasComponent
fuel:hasComponent rdf:type owl:ObjectProperty .


###  http://w3id.org/fuel/hasCurrentQuenchDuration
fuel:hasCurrentQuenchDuration rdf:type owl:ObjectProperty ;
                              rdfs:domain fuel:current_quench ;
                              rdfs:range fuel:current_quench_duration ;
                              rdfs:label "has current quench duration"@en ;
                              rdfs:comment "Links a current quench event to its characteristic duration (~10–100 ms)."@en .


###  http://w3id.org/fuel/hasDisruptionTime
fuel:hasDisruptionTime rdf:type owl:ObjectProperty ;
                       rdfs:domain fuel:plasma_disruption ;
                       rdfs:range fuel:disruption_time ;
                       rdfs:label "has disruption time"@en ;
                       rdfs:comment "Links a plasma disruption to the time instant marking the onset of the disruption (start of the thermal quench)."@en .


###  http://w3id.org/fuel/hasThermalQuenchDuration
fuel:hasThermalQuenchDuration rdf:type owl:ObjectProperty ;
                              rdfs:domain fuel:thermal_quench ;
                              rdfs:range fuel:thermal_quench_duration ;
                              rdfs:label "has thermal quench duration"@en ;
                              rdfs:comment "Links a thermal quench event to its characteristic duration (~1 ms)."@en .


###  http://w3id.org/fuel/hasTimeMax
fuel:hasTimeMax rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf time:hasEnd ;
                rdfs:domain fuel:plasma_time_region ;
                rdfs:range time:Instant ;
                rdfs:label "has time max"@en ;
                rdfs:comment "The latest time instant bounding a plasma time region, representing the end of the event."@en .


###  http://w3id.org/fuel/hasTimeMin
fuel:hasTimeMin rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf time:hasBeginning ;
                rdfs:domain fuel:plasma_time_region ;
                rdfs:range time:Instant ;
                rdfs:label "has time min"@en ;
                rdfs:comment "The earliest time instant bounding a plasma time region, representing the onset of the event."@en .


###  http://w3id.org/fuel/hasTimeRegion
fuel:hasTimeRegion rdf:type owl:ObjectProperty ;
                   rdfs:domain fuel:plasma_event ;
                   rdfs:range fuel:plasma_time_region ;
                   rdfs:label "has time region"@en ;
                   rdfs:comment "Links an extended plasma event to its temporal region, bounded by a minimum and maximum time instant. Applicable to events such as ELMs, sawtooth oscillations, and confinement regimes."@en .


###  http://w3id.org/fuel/usesCoordinateConvention
fuel:usesCoordinateConvention rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://w3id.org/fuel/COCOSconvention
fuel:COCOSconvention rdf:type owl:Class ;
                     rdfs:subClassOf fuel:Tokamak_Coordinate_Conventions ;
                     dcterms:source "https://wpcd-workflows.github.io/conventions.html"@en ;
                     rdfs:label "COordinate COnventionS"@en ;
                     skos:altLabel "COCOS conventions"@en .


###  http://w3id.org/fuel/ECRHSystem
fuel:ECRHSystem rdf:type owl:Class ;
                rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/ICRHSystem
fuel:ICRHSystem rdf:type owl:Class ;
                rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/Langmuir_probe
fuel:Langmuir_probe rdf:type owl:Class ;
                    rdfs:subClassOf fuel:plasma_diagnostics ;
                    dcterms:source "https://en.wikipedia.org/wiki/Langmuir_probe"@en ;
                    <http://schema.org/image> <https://en.wikipedia.org/wiki/Langmuir_probe#/media/File:Rosetta_Langmuir_Probe.jpg> ;
                    rdfs:comment "A Langmuir probe is a device used to determine the electron temperature, electron density, and electric potential of a plasma. It works by inserting one or more electrodes into a plasma, with a constant or time-varying electric potential between the various electrodes or between them and the surrounding vessel. The measured currents and potentials in this system allow the determination of the physical properties of the plasma."@en ;
                    rdfs:label "Langmuir probe"@en ;
                    skos:definition "A Langmuir probe is a device used to determine the electron temperature, electron density, and electric potential of a plasma. It works by inserting one or more electrodes into a plasma, with a constant or time-varying electric potential between the various electrodes or between them and the surrounding vessel. The measured currents and potentials in this system allow the determination of the physical properties of the plasma."@en .


###  http://w3id.org/fuel/LowerHybridSystem
fuel:LowerHybridSystem rdf:type owl:Class ;
                       rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/MHDInstabilityProcess
fuel:MHDInstabilityProcess rdf:type owl:Class ;
                           rdfs:subClassOf fuel:plasma_instability_process .


###  http://w3id.org/fuel/MHD_instability
fuel:MHD_instability rdf:type owl:Class ;
                     rdfs:subClassOf fuel:stability ;
                     rdfs:label "MHD instability"@en ;
                     skos:definition "Instabilities driven by the energy of the magnetic field and by the momentum of charged particles in the plasma. Small displacements of plasma density from the equilibrium position can reinforce that displacement until a further compensating force counteracts that reinforcement or the plasma equilibrium configuration is disrupted. Various modes of such displacement in the toroidal and poloidal planes can be stabilised so that the bulk plasma remains in position."@en .


###  http://w3id.org/fuel/MHDstability
fuel:MHDstability rdf:type owl:Class ;
                  rdfs:subClassOf fuel:stability ;
                  rdfs:label "MHD stability" ;
                  skos:altLabel "magnetohydrodynamic stability" .


###  http://w3id.org/fuel/Thomson_Scattering_system
fuel:Thomson_Scattering_system rdf:type owl:Class ;
                               rdfs:subClassOf fuel:plasma_diagnostics ,
                                               sosa:Sensor ;
                               dcterms:source "https://en.wikipedia.org/wiki/Thomson_scattering"@en ;
                               rdfs:comment "A diagnostic system that measures the electron temperature (Te) and electron density (ne) profiles of a plasma by analysing the spectrum and intensity of laser light scattered by free electrons. Thomson scattering systems provide accurate local measurements along spatial chords and are used to characterise the pedestal, internal transport barriers, and thermal quench dynamics."@en ;
                               rdfs:label "Thomson scattering"@en ,
                                          "dispersión de Thomson"@es ;
                               skos:altLabel "Thomson Scattering system"@en ,
                                             "Thomson scattering diagnostic"@en ,
                                             "LIDAR Thomson scattering"@en ;
                               skos:definition "Thomson scattering is the elastic scattering of electromagnetic radiation by a free charged particle, as described by classical electromagnetism."@en .


###  http://w3id.org/fuel/Tokamak_Coordinate_Conventions
fuel:Tokamak_Coordinate_Conventions rdf:type owl:Class ;
                                    rdfs:subClassOf fuel:representation_convention ;
                                    rdfs:label "Tokamak Coordinate Conventions"@en .


###  http://w3id.org/fuel/alpha_particle_population
fuel:alpha_particle_population rdf:type owl:Class ;
                               rdfs:subClassOf fuel:non_thermal_particle_population .


###  http://w3id.org/fuel/blanket
fuel:blanket rdf:type owl:Class ;
             rdfs:subClassOf fuel:tokamak_component ;
             dcterms:source "https://www.energyencyclopedia.com/en/glossary/blanket"@en ;
             rdfs:label "blanket"@en ;
             skos:definition "The lining of the inner wall of the tokamak vessel that will be in direct contact with the hot plasma. The blanket is usually made of modules (from stainless steel, or copper), on which can be mounted replaceable first-wall panels (made from beryllium, tungsten, molybdenum, or carbon in case of older tokamaks), able to withstand high temperatures. The blanket protects the chamber wall and the magnetic coils from high-energy neutrons. These slowdown in the blanket material and transform their energy into thermal energy."@en .


###  http://w3id.org/fuel/bolometer
fuel:bolometer rdf:type owl:Class ;
               rdfs:subClassOf fuel:plasma_diagnostics ,
                               sosa:Sensor ;
               dcterms:source "https://en.wikipedia.org/wiki/Bolometer"@en ;
               <http://schema.org/image> <https://en.wikipedia.org/wiki/Bolometer#/media/File:Bolometer_conceptual_schematic.svg> ;
               rdfs:comment "A bolometer is a device for measuring radiant heat by means of a material having a temperature-dependent electrical resistance."@en ,
                            "A diagnostic device that measures the total power radiated by the plasma across a broad spectral range, including line radiation, bremsstrahlung, and cyclotron radiation. Bolometers monitor the radiated power fraction and detect radiation-driven disruption precursors such as MARFEs and radiative collapses."@en ;
               rdfs:label "bolometer"@en ,
                          "bolómetro"@es ;
               skos:altLabel "radiation bolometer"@en ,
                             "plasma bolometer"@en ;
               skos:definition "A bolometer is a device for measuring radiant heat by means of a material having a temperature-dependent electrical resistance."@en ;
               skos:editorialNote "Bolometers play a pivotal role in monitoring radiation in fusion plasmas. https://en.wikipedia.org/wiki/Bolometer"@en .


###  http://w3id.org/fuel/campaign
fuel:campaign rdf:type owl:Class ;
              rdfs:subClassOf fuel:process ;
              rdfs:comment "A set of connected experiments that are run across a time period."@en ,
                           "Un conjunto de experimentos conectados que se ejecutan durante un período específico de tiempo"@es ;
              rdfs:label "campaign"@en ,
                         "campaña"@es ;
              skos:altLabel "experimental campaign"@en .


###  http://w3id.org/fuel/central_solenoid
fuel:central_solenoid rdf:type owl:Class ;
                      rdfs:subClassOf fuel:magnet_system ;
                      dcterms:source "https://www.jt60sa.org/wp/glossary/"@en ;
                      rdfs:label "central solenoid"@en ;
                      skos:definition "The tokamak component that produces and sustains the plasma current which heats and shapes the plasma." .


###  http://w3id.org/fuel/core_plasma
fuel:core_plasma rdf:type owl:Class ;
                 rdfs:subClassOf fuel:tokamak_plasma .


###  http://w3id.org/fuel/core_region
fuel:core_region rdf:type owl:Class ;
                 rdfs:subClassOf fuel:plasma_region ;
                 rdfs:label "core region"@en .


###  http://w3id.org/fuel/density
fuel:density rdf:type owl:Class ;
             rdfs:subClassOf fuel:physical_quality .


###  http://w3id.org/fuel/desorbed_gas
fuel:desorbed_gas rdf:type owl:Class ;
                  rdfs:subClassOf fuel:wall_released_species .


###  http://w3id.org/fuel/device_component
fuel:device_component rdf:type owl:Class ;
                      rdfs:subClassOf fuel:material_entity ;
                      rdfs:label "device component"@en ;
                      skos:definition "A material entity that is a proper part of some device."@en .


###  http://w3id.org/fuel/diagnostic_port
fuel:diagnostic_port rdf:type owl:Class ;
                     rdfs:subClassOf fuel:tokamak_component .


###  http://w3id.org/fuel/diagnostics
fuel:diagnostics rdf:type owl:Class ;
                 rdfs:subClassOf fuel:fusion_device_component ;
                 dcterms:source <https://www.iter.org/fusion-glossary> ;
                 rdfs:comment "Equipment for determining/monitoring the properties and behaviour of a plasma during an experiment."@en ;
                 rdfs:label "diagnostic system"@en ;
                 skos:altLabel "diagnostics" .


###  http://w3id.org/fuel/divertor
fuel:divertor rdf:type owl:Class ;
              rdfs:subClassOf fuel:tokamak_component ;
              dcterms:source <https://en.wikipedia.org/wiki/Divertor> ;
              rdfs:comment "In magnetic confinement fusion, a divertor is a device which extracts heat and ash from fusion plasmas by averting direct contact between the confined plasma and the main chamber wall (plasma-wall interactions)."@en ;
              rdfs:label "divertor"@en .


###  http://w3id.org/fuel/divertor_plasma
fuel:divertor_plasma rdf:type owl:Class ;
                     rdfs:subClassOf fuel:plasma .


###  http://w3id.org/fuel/divertor_tokamak
fuel:divertor_tokamak rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( fuel:tokamak
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty fuel:hasComponent ;
                                                                   owl:someValuesFrom fuel:divertor
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf fuel:tokamak .


###  http://w3id.org/fuel/edge_plasma
fuel:edge_plasma rdf:type owl:Class ;
                 rdfs:subClassOf fuel:tokamak_plasma .


###  http://w3id.org/fuel/edge_region
fuel:edge_region rdf:type owl:Class ;
                 rdfs:subClassOf fuel:plasma_region ;
                 rdfs:label "edge region"@en .


###  http://w3id.org/fuel/electric_field
fuel:electric_field rdf:type owl:Class ;
                    rdfs:subClassOf fuel:field .


###  http://w3id.org/fuel/electron_density
fuel:electron_density rdf:type owl:Class ;
                      rdfs:subClassOf fuel:density .


###  http://w3id.org/fuel/electron_population
fuel:electron_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/electron_temperature
fuel:electron_temperature rdf:type owl:Class ;
                          rdfs:subClassOf fuel:temperature ;
                          dcterms:source "https://en.wikipedia.org/wiki/Plasma_parameters#Electron_temperature"@en .


###  http://w3id.org/fuel/fast_ion_population
fuel:fast_ion_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:non_thermal_particle_population .


###  http://w3id.org/fuel/field
fuel:field rdf:type owl:Class .


###  http://w3id.org/fuel/first_wall
fuel:first_wall rdf:type owl:Class ;
                rdfs:subClassOf fuel:tokamak_component ;
                dcterms:source "https://www.jt60sa.org/wp/glossary/"@en ;
                rdfs:label "first wall"@en ;
                skos:definition "The interior surface of a tokamak closest to the plasma"@en .


###  http://w3id.org/fuel/fusion_device_component
fuel:fusion_device_component rdf:type owl:Class ;
                             rdfs:subClassOf fuel:device_component ;
                             rdfs:label "fusion device component"@en .


###  http://w3id.org/fuel/fusion_facility
fuel:fusion_facility rdf:type owl:Class ;
                     rdfs:subClassOf fuel:material_entity ;
                     rdfs:comment "A facility in which fusion experiments are conducted. Examples include the Joint European Torus (JET) in the UK, the DIII-D National Fusion Facility in the US, and the Experimental Advanced Superconducting Tokamak (EAST) in China."@en ,
                                  "Una instalación en la que se llevan a cabo experimentos de fusión. Ejemplos incluyen el Joint European Torus (JET) en el Reino Unido, el DIII-D National Fusion Facility en los Estados Unidos y el Experimental Advanced Superconducting Tokamak (EAST) en China."@es ;
                     rdfs:label "fusion facility"@en ,
                                "instalación de fusión"@es ;
                     skos:altLabel "fusion research facility"@en ,
                                   "instalación de investigación de fusión"@es .


###  http://w3id.org/fuel/fusion_reactor
fuel:fusion_reactor rdf:type owl:Class ;
                    rdfs:subClassOf fuel:nuclear_reactor ;
                    dcterms:source <https://www.energyencyclopedia.com/en/glossary/fusion-reactor/> ;
                    rdfs:comment "A device in which controlled thermonuclear fusion takes place, either for scientific purposes or for the production of energy. Since there are different ways to achieve fusion conditions, a fusion reactor can be a tokamak, a stellarator, a fusor or any other device in which the conditions for fusion can be achieved and maintained."@en ,
                                 "Dispositivo en el que se produce la fusión termonuclear controlada, ya sea con fines científicos o para la producción de energía. Dado que existen diferentes maneras de lograr las condiciones de fusión, un reactor de fusión puede ser un tokamak, un stellarator, un fusor o cualquier otro dispositivo que permita alcanzar y mantener las condiciones para la fusión."@es ;
                    rdfs:label "fusion reactor"@en ,
                               "reactor de fusión"@es ;
                    skos:altLabel "dispositivo de fusión"@es ,
                                  "fusion device"@en ,
                                  "nuclear fusion reactor"@en ,
                                  "reactor de fusión nuclear"@es .


###  http://w3id.org/fuel/heating_system
fuel:heating_system rdf:type owl:Class ;
                    rdfs:subClassOf fuel:tokamak_component ;
                    rdfs:label "heating system"@en .


###  http://w3id.org/fuel/ideal_kink_stability
fuel:ideal_kink_stability rdf:type owl:Class ;
                          rdfs:subClassOf fuel:MHDstability .


###  http://w3id.org/fuel/impurity_population
fuel:impurity_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/information_contennt_entity
fuel:information_contennt_entity rdf:type owl:Class ;
                                 rdfs:comment "from IAO - http://purl.obolibrary.org/obo/IAO_0000030" ;
                                 rdfs:label "information content entity" .


###  http://w3id.org/fuel/injected_neutral_particle_population
fuel:injected_neutral_particle_population rdf:type owl:Class ;
                                          rdfs:subClassOf fuel:neutral_particule_population .


###  http://w3id.org/fuel/inner_core_region
fuel:inner_core_region rdf:type owl:Class ;
                       rdfs:subClassOf fuel:core_region .


###  http://w3id.org/fuel/interferometer
fuel:interferometer rdf:type owl:Class ;
                    rdfs:subClassOf fuel:plasma_diagnostics ,
                                    sosa:Sensor ;
                    dcterms:source "https://en.wikipedia.org/wiki/Interferometry"@en ;
                    rdfs:comment "A diagnostic system that measures the line-integrated electron density of a plasma by detecting the phase shift of a beam of electromagnetic radiation (typically microwave or infrared) passed through the plasma. Interferometers are used to measure average electron density, monitor the approach to the Greenwald density limit, and detect density-related disruption precursors."@en ;
                    rdfs:label "interferometer"@en ,
                               "interferómetro"@es ;
                    skos:altLabel "plasma interferometer"@en ,
                                  "microwave interferometer"@en .


###  http://w3id.org/fuel/ion_population
fuel:ion_population rdf:type owl:Class ;
                    rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/iter_pdm
fuel:iter_pdm rdf:type owl:Class ;
              dcterms:source <https://doi.org/10.1088/0029-5515/55/12/123006> ;
              rdfs:comment "ITER standardized data model"@en ;
              rdfs:label "ITER Physics Data Model"@en ;
              skos:altLabel "ITER PDM"@en ,
                            "PDM"@en .


###  http://w3id.org/fuel/kinetic_stability
fuel:kinetic_stability rdf:type owl:Class ;
                       rdfs:subClassOf fuel:stability .


###  http://w3id.org/fuel/laser_induced_plasma
fuel:laser_induced_plasma rdf:type owl:Class ;
                          rdfs:subClassOf fuel:plasma ;
                          dcterms:source <https://www.sciencedirect.com/topics/chemistry/laser-induced-plasma> ;
                          rdfs:comment "Laser induced plasma (LIP) is defined as a product of the complex interaction between a focused, high peak power laser beam and a target material, resulting in processes such as absorption of laser energy, vaporization, and ejection of atomic and molecular species, followed by plasma expansion and shock wave production."@en ;
                          rdfs:label "laser induced plasma"@en ;
                          skos:altLabel "LIP"@en ;
                          skos:editorialNote "industrial plasma - not a tokamak plasma"@en .


