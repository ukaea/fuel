###  http://w3id.org/fuel/ECRHSystem
fuel:ECRHSystem rdf:type owl:Class ;
                rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/ICRHSystem
fuel:ICRHSystem rdf:type owl:Class ;
                rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/LowerHybridSystem
fuel:LowerHybridSystem rdf:type owl:Class ;
                       rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/MHDInstabilityProcess
fuel:MHDInstabilityProcess rdf:type owl:Class ;
                           rdfs:subClassOf fuel:plasma_instability_process .


###  http://w3id.org/fuel/MHD_instability
fuel:MHD_instability rdf:type owl:Class ;
                     rdfs:subClassOf fuel:stability ;
                     rdfs:label "MHD instability"@en ;
                     skos:definition "Instabilities driven by the energy of the magnetic field and by the momentum of charged particles in the plasma. Small displacements of plasma density from the equilibrium position can reinforce that displacement until a further compensating force counteracts that reinforcement or the plasma equilibrium configuration is disrupted. Various modes of such displacement in the toroidal and poloidal planes can be stabilised so that the bulk plasma remains in position."@en .


###  http://w3id.org/fuel/MHDstability
fuel:MHDstability rdf:type owl:Class ;
                  rdfs:subClassOf fuel:stability ;
                  rdfs:label "MHD stability" ;
                  skos:altLabel "magnetohydrodynamic stability" .


###  http://w3id.org/fuel/Thomson_Scattering_system
fuel:Thomson_Scattering_system rdf:type owl:Class ;
                               rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/alpha_particle_population
fuel:alpha_particle_population rdf:type owl:Class ;
                               rdfs:subClassOf fuel:non_thermal_particle_population .


###  http://w3id.org/fuel/blanket
fuel:blanket rdf:type owl:Class ;
             rdfs:subClassOf fuel:tokamak_component ;
             dcterms:source "https://www.energyencyclopedia.com/en/glossary/blanket"@en ;
             rdfs:label "blanket"@en ;
             skos:definition "The lining of the inner wall of the tokamak vessel that will be in direct contact with the hot plasma. The blanket is usually made of modules (from stainless steel, or copper), on which can be mounted replaceable first-wall panels (made from beryllium, tungsten, molybdenum, or carbon in case of older tokamaks), able to withstand high temperatures. The blanket protects the chamber wall and the magnetic coils from high-energy neutrons. These slowdown in the blanket material and transform their energy into thermal energy."@en .


###  http://w3id.org/fuel/bolometer
fuel:bolometer rdf:type owl:Class ;
               rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/campaign
fuel:campaign rdf:type owl:Class ;
              rdfs:subClassOf fuel:process ;
              rdfs:comment "A set of connected experiments that are run across a time period."@en ,
                           "Un conjunto de experimentos conectados que se ejecutan durante un período específico de tiempo"@es ;
              rdfs:label "campaign"@en ,
                         "campaña"@es ;
              skos:altLabel "experimental campaign"@en .


###  http://w3id.org/fuel/central_solenoid
fuel:central_solenoid rdf:type owl:Class ;
                      rdfs:subClassOf fuel:magnet_system ;
                      dcterms:source "https://www.jt60sa.org/wp/glossary/"@en ;
                      rdfs:label "central solenoid"@en ;
                      skos:definition "The tokamak component that produces and sustains the plasma current which heats and shapes the plasma." .


###  http://w3id.org/fuel/core_plasma
fuel:core_plasma rdf:type owl:Class ;
                 rdfs:subClassOf fuel:tokamak_plasma .


###  http://w3id.org/fuel/core_region
fuel:core_region rdf:type owl:Class ;
                 rdfs:subClassOf fuel:plasma_region ;
                 rdfs:label "core region"@en .


###  http://w3id.org/fuel/desorbed_gas
fuel:desorbed_gas rdf:type owl:Class ;
                  rdfs:subClassOf fuel:wall_released_species .


###  http://w3id.org/fuel/device_component
fuel:device_component rdf:type owl:Class ;
                      rdfs:subClassOf fuel:material_entity ;
                      rdfs:label "device component"@en ;
                      skos:definition "A material entity that is a proper part of some device."@en .


###  http://w3id.org/fuel/diagnostic_port
fuel:diagnostic_port rdf:type owl:Class ;
                     rdfs:subClassOf fuel:tokamak_component .


###  http://w3id.org/fuel/diagnostics
fuel:diagnostics rdf:type owl:Class ;
                 rdfs:subClassOf fuel:fusion_device_component ;
                 dcterms:source <https://www.iter.org/fusion-glossary> ;
                 rdfs:comment "Equipment for determining/monitoring the properties and behaviour of a plasma during an experiment."@en ;
                 rdfs:label "diagnostic system"@en ;
                 skos:altLabel "diagnostics" .


###  http://w3id.org/fuel/divertor
fuel:divertor rdf:type owl:Class ;
              rdfs:subClassOf fuel:tokamak_component ;
              dcterms:source <https://en.wikipedia.org/wiki/Divertor> ;
              rdfs:comment "In magnetic confinement fusion, a divertor is a device which extracts heat and ash from fusion plasmas by averting direct contact between the confined plasma and the main chamber wall (plasma-wall interactions)."@en ;
              rdfs:label "divertor"@en .


###  http://w3id.org/fuel/divertor_plasma
fuel:divertor_plasma rdf:type owl:Class ;
                     rdfs:subClassOf fuel:plasma .


###  http://w3id.org/fuel/divertor_tokamak
fuel:divertor_tokamak rdf:type owl:Class ;
                      owl:equivalentClass [ owl:intersectionOf ( fuel:tokamak
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty fuel:hasComponent ;
                                                                   owl:someValuesFrom fuel:divertor
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ] ;
                      rdfs:subClassOf fuel:tokamak .


###  http://w3id.org/fuel/edge_plasma
fuel:edge_plasma rdf:type owl:Class ;
                 rdfs:subClassOf fuel:tokamak_plasma .


###  http://w3id.org/fuel/edge_region
fuel:edge_region rdf:type owl:Class ;
                 rdfs:subClassOf fuel:plasma_region ;
                 rdfs:label "edge region"@en .


###  http://w3id.org/fuel/electric_field
fuel:electric_field rdf:type owl:Class ;
                    rdfs:subClassOf fuel:field .


###  http://w3id.org/fuel/electron_population
fuel:electron_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/fast_ion_population
fuel:fast_ion_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:non_thermal_particle_population .


###  http://w3id.org/fuel/field
fuel:field rdf:type owl:Class .


###  http://w3id.org/fuel/first_wall
fuel:first_wall rdf:type owl:Class ;
                rdfs:subClassOf fuel:tokamak_component ;
                dcterms:source "https://www.jt60sa.org/wp/glossary/"@en ;
                rdfs:label "first wall"@en ;
                skos:definition "The interior surface of a tokamak closest to the plasma"@en .


###  http://w3id.org/fuel/fusion_device_component
fuel:fusion_device_component rdf:type owl:Class ;
                             rdfs:subClassOf fuel:device_component ;
                             rdfs:label "fusion device component"@en .


###  http://w3id.org/fuel/fusion_facility
fuel:fusion_facility rdf:type owl:Class ;
                     rdfs:subClassOf fuel:material_entity ;
                     rdfs:comment "A facility in which fusion experiments are conducted. Examples include the Joint European Torus (JET) in the UK, the DIII-D National Fusion Facility in the US, and the Experimental Advanced Superconducting Tokamak (EAST) in China."@en ,
                                  "Una instalación en la que se llevan a cabo experimentos de fusión. Ejemplos incluyen el Joint European Torus (JET) en el Reino Unido, el DIII-D National Fusion Facility en los Estados Unidos y el Experimental Advanced Superconducting Tokamak (EAST) en China."@es ;
                     rdfs:label "fusion facility"@en ,
                                "instalación de fusión"@es ;
                     skos:altLabel "fusion research facility"@en ,
                                   "instalación de investigación de fusión"@es .


###  http://w3id.org/fuel/fusion_reactor
fuel:fusion_reactor rdf:type owl:Class ;
                    rdfs:subClassOf fuel:nuclear_reactor ;
                    dcterms:source <https://www.energyencyclopedia.com/en/glossary/fusion-reactor/> ;
                    rdfs:comment "A device in which controlled thermonuclear fusion takes place, either for scientific purposes or for the production of energy. Since there are different ways to achieve fusion conditions, a fusion reactor can be a tokamak, a stellarator, a fusor or any other device in which the conditions for fusion can be achieved and maintained."@en ,
                                 "Dispositivo en el que se produce la fusión termonuclear controlada, ya sea con fines científicos o para la producción de energía. Dado que existen diferentes maneras de lograr las condiciones de fusión, un reactor de fusión puede ser un tokamak, un stellarator, un fusor o cualquier otro dispositivo que permita alcanzar y mantener las condiciones para la fusión."@es ;
                    rdfs:label "fusion reactor"@en ,
                               "reactor de fusión"@es ;
                    skos:altLabel "dispositivo de fusión"@es ,
                                  "fusion device"@en ,
                                  "nuclear fusion reactor"@en ,
                                  "reactor de fusión nuclear"@es .


###  http://w3id.org/fuel/heating_system
fuel:heating_system rdf:type owl:Class ;
                    rdfs:subClassOf fuel:tokamak_component ;
                    rdfs:label "heating system"@en .


###  http://w3id.org/fuel/ideal_kink_stability
fuel:ideal_kink_stability rdf:type owl:Class ;
                          rdfs:subClassOf fuel:MHDstability .


###  http://w3id.org/fuel/impurity_population
fuel:impurity_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/injected_neutral_particle_population
fuel:injected_neutral_particle_population rdf:type owl:Class ;
                                          rdfs:subClassOf fuel:neutral_particule_population .


###  http://w3id.org/fuel/inner_core_region
fuel:inner_core_region rdf:type owl:Class ;
                       rdfs:subClassOf fuel:core_region .


###  http://w3id.org/fuel/interferometer
fuel:interferometer rdf:type owl:Class ;
                    rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/ion_population
fuel:ion_population rdf:type owl:Class ;
                    rdfs:subClassOf fuel:thermal_particle_population .


###  http://w3id.org/fuel/iter_pdm
fuel:iter_pdm rdf:type owl:Class ;
              dcterms:source <https://doi.org/10.1088/0029-5515/55/12/123006> ;
              rdfs:comment "ITER standardized data model"@en ;
              rdfs:label "ITER Physics Data Model"@en ;
              skos:altLabel "ITER PDM"@en ,
                            "PDM"@en .


###  http://w3id.org/fuel/kinetic_stability
fuel:kinetic_stability rdf:type owl:Class ;
                       rdfs:subClassOf fuel:stability .


###  http://w3id.org/fuel/laser_induced_plasma
fuel:laser_induced_plasma rdf:type owl:Class ;
                          rdfs:subClassOf fuel:plasma ;
                          dcterms:source <https://www.sciencedirect.com/topics/chemistry/laser-induced-plasma> ;
                          rdfs:comment "Laser induced plasma (LIP) is defined as a product of the complex interaction between a focused, high peak power laser beam and a target material, resulting in processes such as absorption of laser energy, vaporization, and ejection of atomic and molecular species, followed by plasma expansion and shock wave production."@en ;
                          rdfs:label "laser induced plasma"@en ;
                          skos:altLabel "LIP"@en ;
                          skos:editorialNote "industrial plasma - not a tokamak plasma"@en .


###  http://w3id.org/fuel/limiter
fuel:limiter rdf:type owl:Class ;
             rdfs:subClassOf fuel:tokamak_component .


###  http://w3id.org/fuel/magnet_system
fuel:magnet_system rdf:type owl:Class ;
                   rdfs:subClassOf fuel:fusion_device_component ;
                   rdfs:label "magnetic system"@en .


###  http://w3id.org/fuel/magnetic_field
fuel:magnetic_field rdf:type owl:Class ;
                    rdfs:subClassOf fuel:field ;
                    dcterms:source "https://www.energyencyclopedia.com/en/glossary/magnetic-field" ;
                    rdfs:label "magnetic field"@en ,
                               "campo magnético" ;
                    skos:definition """A vector field showing how magnetic forces are distributed in space. A magnetic field describes how the magnetic force at a given point in space will act on a ferromagnetic object or charged particle. In a magnetic field, the Lorentz force on a charged particle is perpendicular to both the direction of the magnetic field and its velocity. Magnetic fields surround magnetized objects, are formed around conductors through which electric current flows, or at a point with a varying electric field. It is described by the quantities B and H. B is the magnetic flux density and is given in units of tesla. A common refrigerator magnet is usually 0.001 tesla. The quantity H describes the magnetic field strength and is expressed in amperes per meter.

Rotating magnetic fields are used by electrical generators in power plants.

In thermonuclear fusion research, a strong magnetic field is used to confine hot plasma in tokamaks and stellarators."""@en .


###  http://w3id.org/fuel/magnetic_field_density
fuel:magnetic_field_density rdf:type owl:Class ;
                            rdfs:subClassOf fuel:quality ;
                            rdfs:label "magnetic field density"@en .


###  http://w3id.org/fuel/magnetic_probe
fuel:magnetic_probe rdf:type owl:Class ;
                    rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/material_entity
fuel:material_entity rdf:type owl:Class ;
                     rdfs:comment """Consider reusing to BFO:material_entity
http://purl.obolibrary.org/obo/BFO_0000040""" .


###  http://w3id.org/fuel/neutral_beam
fuel:neutral_beam rdf:type owl:Class ;
                  rdfs:subClassOf fuel:injected_neutral_particle_population ;
                  skos:editorialNote "is this a subclass of injected neutral particle population?" .


###  http://w3id.org/fuel/neutral_beam_system
fuel:neutral_beam_system rdf:type owl:Class ;
                         rdfs:subClassOf fuel:heating_system .


###  http://w3id.org/fuel/neutral_particule_population
fuel:neutral_particule_population rdf:type owl:Class ;
                                  rdfs:subClassOf fuel:particle_population ;
                                  rdfs:label "neutral particle population"@en .


###  http://w3id.org/fuel/neutron_diagnostics
fuel:neutron_diagnostics rdf:type owl:Class ;
                         rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/neutronics
fuel:neutronics rdf:type owl:Class ;
                dcterms:source <https://www.cea.fr/english/Pages/resources/nuclear-energy-monographs/neutronics.aspx> ;
                rdfs:comment "Neutronics (or neutron physics) is the study of neutron paths through matter, of conditions for a chain reaction, and of alterations in matter's composition induced by nuclear reactions."@en ;
                rdfs:label "neutronics"@en ;
                skos:altLabel "neutron physics"@en .


###  http://w3id.org/fuel/non_thermal_particle_population
fuel:non_thermal_particle_population rdf:type owl:Class ;
                                     rdfs:subClassOf fuel:particle_population .


###  http://w3id.org/fuel/nuclear_reactor
fuel:nuclear_reactor rdf:type owl:Class ;
                     rdfs:subClassOf fuel:material_entity ;
                     dcterms:source <https://www.energyencyclopedia.com/en/glossary/nuclear-reactor> ;
                     rdfs:comment "A device inside which a controlled chain fission reaction takes place. The reactor usually has the form of a metal pressure vessel, in the middle of which the nuclear fuel is arranged in a so-called core. A coolant, whether gas or liquid, circulates through the core to dissipate the heat generated by the fission reaction. The power of the reactor is controlled by control rods that are inserted or withdrawn from the core as necessary. If the reactor uses thermal neutrons for fission, it also includes a moderator, either in the form of a liquid or a solid, which slows down the neutrons. Heat, generated by a reactor, is most commonly used. Either directly for technological purposes (e.g., hydrogen production by steam reforming) or for electricity generation by a steam turbine. The reactor can also be used to produce nuclear fuel (breeder reactor), or the strong neutron fluxes produced by the reaction can be used for research purposes or for the production of radiopharmaceuticals. There are a number of types of nuclear reactors, with the most common types used for electricity generation being water-cooled PWRs and BWRs. In 2023, there were 436 nuclear reactors in operation in the world."@en ,
                                  "Dispositivo en el que ocurre una reacción nuclear en cadena controlada y autosostenida. Los reactores nucleares se utilizan en las centrales nucleares para la generación de electricidad y en la propulsión de barcos. El calor de la fis nuclear se transfiere a un fluido de trabajo (agua o gas), que pasa por turbinas."@es ;
                     rdfs:label "nuclear reactor"@en ,
                                "reactor nuclear"@es ;
                     skos:altLabel "nuclear fission reactor"@en ,
                                   "reactor de fisión nuclear"@es .


###  http://w3id.org/fuel/operational_stability
fuel:operational_stability rdf:type owl:Class ;
                           rdfs:subClassOf fuel:stability .


###  http://w3id.org/fuel/optical_diagnostic_system
fuel:optical_diagnostic_system rdf:type owl:Class ;
                               rdfs:subClassOf fuel:diagnostics .


###  http://w3id.org/fuel/outer_core_region
fuel:outer_core_region rdf:type owl:Class ;
                       rdfs:subClassOf fuel:core_region .


###  http://w3id.org/fuel/particle_population
fuel:particle_population rdf:type owl:Class ;
                         rdfs:subClassOf fuel:material_entity .


###  http://w3id.org/fuel/pedestal_region
fuel:pedestal_region rdf:type owl:Class ;
                     rdfs:subClassOf fuel:plasma_region .


###  http://w3id.org/fuel/physics_process
fuel:physics_process rdf:type owl:Class ;
                     rdfs:subClassOf fuel:process ;
                     rdfs:label "physics process" .


###  http://w3id.org/fuel/plasma
fuel:plasma rdf:type owl:Class ;
            rdfs:subClassOf fuel:material_entity ;
            dcterms:source <https://www.iter.org/fusion-glossary> ;
            rdfs:comment "The fourth state of matter. At extreme temperatures, electrons are separated from nuclei and a gas becomes a plasma - a hot, electrically charged gas. In a star as in a fusion device, plasmas provide the environment in which light elements can fuse and yield energy. Some 99% of the known universe is in the plasma state. Examples of plasmas include the sun, fluorescent light bulbs, and other gas-discharge tubes."@en ;
            rdfs:label "plasma"@en ,
                       "plasma"@es ;
            skos:definition "The fourth state of matter. At extreme temperatures, electrons are separated from nuclei and a gas becomes a plasma - a hot, electrically charged gas. In a star as in a fusion device, plasmas provide the environment in which light elements can fuse and yield energy. Some 99% of the known universe is in the plasma state. Examples of plasmas include the sun, fluorescent light bulbs, and other gas-discharge tubes."@en .


###  http://w3id.org/fuel/plasma_instability_process
fuel:plasma_instability_process rdf:type owl:Class ;
                                rdfs:subClassOf fuel:physics_process ;
                                rdfs:label "plasma instability process"@en .


###  http://w3id.org/fuel/plasma_region
