  {
    "@id": "http://w3id.org/fuel/campaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A set of connected experiments that are run across a time period."
      },
      {
        "@language": "es",
        "@value": "Un conjunto de experimentos conectados que se ejecutan durante un período específico de tiempo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "campaign"
      },
      {
        "@language": "es",
