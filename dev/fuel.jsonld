        "@language": "en",
        "@value": "experimental campaign"
      }
    ]
  },
  {
    "@id": "http://w3id.org/fuel/vacuum_vessel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@value": "https://www.iter.org/machine/vacuum-vessel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
