    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( fuel:tokamak [ a owl:Restriction ;
                        owl:onProperty fuel:hasComponent ;
                        owl:someValuesFrom fuel:divertor ] ) ] .

