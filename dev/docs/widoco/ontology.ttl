:material_entity rdf:type owl:Class ;
                 rdfs:comment """Consider mapping to BFO:material_entity
http://purl.obolibrary.org/obo/BFO_0000040""" .


###  http://w3id.org/fuel#neutral_beam_system
:neutral_beam_system rdf:type owl:Class ;
                     rdfs:subClassOf :heating_system .


