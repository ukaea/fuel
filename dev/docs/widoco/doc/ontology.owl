    <!-- http://w3id.org/fuel/laser_induced_plasma -->


    <owl:Class rdf:about="http://w3id.org/fuel/laser_induced_plasma">
        <rdfs:subClassOf rdf:resource="http://w3id.org/fuel/plasma"/>
        <terms:source rdf:resource="https://www.sciencedirect.com/topics/chemistry/laser-induced-plasma"/>
        <rdfs:comment xml:lang="en">Laser induced plasma (LIP) is defined as a product of the complex interaction between a focused, high peak power laser beam and a target material, resulting in processes such as absorption of laser energy, vaporization, and ejection of atomic and molecular species, followed by plasma expansion and shock wave production.</rdfs:comment>
        <rdfs:label xml:lang="en">laser induced plasma</rdfs:label>
        <skos:altLabel xml:lang="en">LIP</skos:altLabel>
        <skos:editorialNote xml:lang="en">industrial plasma - not a tokamak plasma</skos:editorialNote>
    </owl:Class>
    


