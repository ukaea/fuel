    <!-- http://w3id.org/fuel/neutronics -->


    <owl:Class rdf:about="http://w3id.org/fuel/neutronics">
        <terms:source rdf:resource="https://www.cea.fr/english/Pages/resources/nuclear-energy-monographs/neutronics.aspx"/>
        <rdfs:comment xml:lang="en">Neutronics (or neutron physics) is the study of neutron paths through matter, of conditions for a chain reaction, and of alterations in matter&apos;s composition induced by nuclear reactions.</rdfs:comment>
        <rdfs:label xml:lang="en">neutronics</rdfs:label>
        <skos:altLabel xml:lang="en">neutron physics</skos:altLabel>
    </owl:Class>
    


    <!-- http://w3id.org/fuel/non_thermal_particle_population -->


    <owl:Class rdf:about="http://w3id.org/fuel/non_thermal_particle_population">
