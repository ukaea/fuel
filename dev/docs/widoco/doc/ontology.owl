    <!-- http://w3id.org/fuel/scrape_off_layer -->


    <owl:Class rdf:about="http://w3id.org/fuel/scrape_off_layer">
        <rdfs:subClassOf rdf:resource="http://w3id.org/fuel/plasma_region"/>
        <terms:source xml:lang="en">https://www.energyencyclopedia.com/en/glossary/scrape-off-layer-sol</terms:source>
        <rdfs:label xml:lang="en">scrape off layer</rdfs:label>
        <skos:altLabel xml:lang="en">SOL</skos:altLabel>
        <skos:definition>A region at the edge of the plasma characterized by open magnetic lines that terminate at the inner parts of the chamber. In limiter tokamaks this region is located behind the last closed magnetic surface, in divertor tokamaks behind the separatrix. The particles in this region move by convection rather than diffusion and travel along the magnetic lines to the chamber walls or to the divertor, where they can be extracted by vacuum pumps.</skos:definition>
    </owl:Class>
    


