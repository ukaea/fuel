    <dcterms:description xml:lang="en">FUEL is a vocabulary designed to facilitate the interoperability of fusion energy data.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2024-11-06</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
